# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# service_role key, JANGAN dipakai di frontend & JANGAN di-commit
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (yang jawab pertanyaan) ---
# pilihan: anthropic | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# kalau LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# kalau LLM_PROVIDER=openai (juga buat Groq, OpenRouter, Ollama, dll yang kompatibel OpenAI)
OPENAI_API_KEY=
# kosongkan kalau pakai OpenAI asli. Contoh Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=

# --- Embeddings (buat nyari potongan dokumen) ---
# pilihan: openai | voyage
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# kalau EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# kalau EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
